{
	"name": "facility-search-api",
	"version": "1.0.0",
	"description": "RESTful API for searching and filtering fitness facilities",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.0.8",
	"engines": {
		"node": ">=26.11.1"
	},
	"scripts": {
		"prepare": "prisma generate",
		"dev": "node --env-file-if-exists=.env --watch src/server.ts",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"check": "pnpm typecheck && pnpm lint && pnpm test",
		"test": "node --env-file-if-exists=.env --test",
		"seed": "node scripts/generate-facilities.ts",
		"seed:db": "node --env-file-if-exists=.env scripts/seed-db.ts",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:migrate": "prisma migrate dev",
		"db:studio": "prisma studio",
		"generate": "prisma generate",
		"test:watch": "node --env-file-if-exists=.env --test --watch",
		"test:coverage": "node --env-file-if-exists=.env --test --experimental-test-coverage"
	},
	"dependencies": {
		"@fastify/etag": "^6.2.1",
		"@fastify/jwt": "^10.2.4",
		"@fastify/rate-limit": "^11.2.1",
		"@fastify/swagger": "^9.9.2",
		"@fastify/swagger-ui": "^6.1.2",
		"@node-rs/argon2": "^2.2.2",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"fastify": "^5.12.5",
		"fastify-type-provider-zod": "^7.0.0",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"prisma": "7.10.0",
		"typescript": "^7.0.2"
	}
}
