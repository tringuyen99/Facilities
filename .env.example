# Connection string for the Postgres instance in compose.yaml
DATABASE_URL="postgresql://facilities:facilities@localhost:5432/facilities?schema=public"

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Generate your own: openssl rand -base64 32
JWT_SECRET="replace-me-with-at-least-32-random-characters"
JWT_TTL="1h"

# Rate-limit counters. Shared across instances; the API still serves if it is down.
REDIS_URL="redis://localhost:6379"

